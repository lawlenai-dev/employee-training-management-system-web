server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # gzip
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Hashed build assets are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Never cache the shell, otherwise clients pin an old asset manifest.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # Railway healthcheck target.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # No backend is wired up yet. Without this, the SPA fallback answers /api/*
    # with index.html and a 200, so fetch() in src/api.js sees an "ok" response,
    # fails to parse it, and silently resolves to {}. Fail loudly instead.
    location /api/ {
        default_type application/json;
        return 404 '{"message":"API backend is not configured for this deployment"}';
    }

    # SPA fallback for react-router routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
